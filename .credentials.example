# AI Lab Credentials Template
# Copy this file to .credentials and update with your actual values
# The .credentials file is gitignored and will not be committed

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_PASSWORD=<your-postgres-password>

# =============================================================================
# LiteLLM Proxy
# =============================================================================
LITELLM_MASTER_KEY=<your-litellm-master-key>

# =============================================================================
# Langfuse Tracing (get these from Langfuse UI after creating a project)
# =============================================================================
LANGFUSE_PUBLIC_KEY=<your-langfuse-public-key>
LANGFUSE_SECRET_KEY=<your-langfuse-secret-key>

# =============================================================================
# Keycloak Identity Provider
# =============================================================================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=<your-keycloak-admin-password>
KC_DB_PASSWORD=<your-keycloak-db-password>

# Keycloak OIDC Client (for Open WebUI)
OAUTH_CLIENT_ID=openwebui
OAUTH_CLIENT_SECRET=<your-oauth-client-secret>

# =============================================================================
# Default Test Users (created in Keycloak)
# =============================================================================
KEYCLOAK_TEST_USER=admin
KEYCLOAK_TEST_USER_EMAIL=admin@ailab.local
KEYCLOAK_TEST_USER_PASSWORD=<your-test-user-password>

# =============================================================================
# Service URLs
# =============================================================================
OPENWEBUI_URL=http://openwebui.local:3100
LITELLM_URL=http://litellm.local:3100
LANGFUSE_URL=http://langfuse.local:3100
KEYCLOAK_URL=http://keycloak.local:3100
DASHBOARD_URL=http://dashboard.local:3100
