# AI Lab Environment Configuration
# Copy this file to .env and customize values

# PostgreSQL
POSTGRES_PASSWORD=postgres123

# Secrets (generate with: openssl rand -hex 32)
NEXTAUTH_SECRET=change-me-generate-random-string
SALT=change-me-generate-random-string

# LiteLLM Master Key (generate with: openssl rand -hex 32)
LITELLM_MASTER_KEY=sk-change-me-generate-random-key

# Langfuse API Keys (get these from Langfuse UI after first login)
# 1. Go to http://localhost:3000
# 2. Create account and project
# 3. Go to Project Settings > API Keys
# 4. Copy keys here
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
